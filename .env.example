NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Obtenha no painel do Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gateway de Pagamento (ex: MercadoPago, Asaas, Stripe)
PAYMENT_PROVIDER=unconfigured
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Motor de Produção Fotográfica & Geração de Imagens
# Provider: 'default', 'replicate', 'fal', 'comfyui' ou deixe vazio para mock de desenvolvimento
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=https://api.replicate.com/v1
IMAGE_GENERATION_MODEL=flux-instant-id-face-preserve
IMAGE_UPSCALE_MODEL=nightmareai/real-esrgan
IMAGE_ANALYSIS_MODEL=gpt-4o-vision-portrait
TARGET_RESOLUTION=8K # '4K', '8K', 'UHD'

# Provedores legados / atalhos
PRODUCTION_PROVIDER=unconfigured
REPLICATE_API_TOKEN=
FAL_KEY=

# Integração WhatsApp (ex: Evolution API, Z-API, Baileys)
WHATSAPP_PROVIDER=unconfigured
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE_NAME=

# Senha mestre temporária para demonstração do admin sem Supabase Auth (Opcional)
ADMIN_DEMO_PASSWORD=estudio2026admin
